# Postgres (padrão / docker-compose). Em produção use a URL do Postgres gerenciado;
# 'postgres://...' (formato de vários hosts) é aceito e convertido para 'postgresql://'.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock
# Alternativa local sem Postgres (arquivo criado em backend/stock.db):
# DATABASE_URL=sqlite:///./stock.db
# OBRIGATÓRIA (o backend não sobe sem ela). Gere com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Só no seu computador: libera `uv run python seed_dev.py` (contas de teste). NUNCA em produção.
# STOCK_ENV=dev
# Opcional. Só é preciso quando o frontend está em OUTRA origem (dev: página em :3000).
# Em produção o próprio backend serve o frontend (mesma origem) e não precisa de CORS.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Porta do start.sh / Docker (os hosts costumam definir PORT sozinhos):
# PORT=8000
